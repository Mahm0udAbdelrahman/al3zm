APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Travel (config/travel.php) ---
TRAVEL_CURRENCY=OMR
TRAVEL_MARKUP_FLIGHT=0
TRAVEL_MARKUP_STAY=0
TRAVEL_MARKUP_ACTIVITY=0
TRAVEL_RATES_URL=
TRAVEL_SEARCH_TTL=1500
TRAVEL_ORDER_TTL=20

# Duffel — flights + stays (https://app.duffel.com → Developers → Access tokens; duffel_test_… for sandbox)
DUFFEL_ACCESS_TOKEN=
DUFFEL_FLIGHTS_ENABLED=true
DUFFEL_STAYS_ENABLED=true

# Wingie One — flights (payloads provisional until the API docs are in)
WINGIE_ENABLED=false
WINGIE_BASE_URL=https://oneapi.wingieone.com
WINGIE_API_KEY=

# Booking.com Demand API — stays (sandbox: https://demandapi-sandbox.booking.com/3.1)
BOOKING_COM_ENABLED=false
BOOKING_COM_BASE_URL=https://demandapi.booking.com/3.1
BOOKING_COM_TOKEN=
BOOKING_COM_AFFILIATE_ID=

# GetYourGuide Partner API — activities (testing: https://api.testing.getyourguide.com/1)
GETYOURGUIDE_ENABLED=false
GETYOURGUIDE_BASE_URL=https://api.getyourguide.com/1
GETYOURGUIDE_ACCESS_TOKEN=
GETYOURGUIDE_CURRENCY=USD

# --- Payments (config/payments.php) ---
PAYMENTS_APP_RETURN_URL=mnaden://payment-result
THAWANI_ENABLED=false
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_CHECKOUT_URL=https://uatcheckout.thawani.om/pay
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
TAP_ENABLED=false
TAP_SECRET_KEY=
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCIES=USD,EUR,GBP,AED,SAR,OMR
FAKE_GATEWAY_ENABLED=true
